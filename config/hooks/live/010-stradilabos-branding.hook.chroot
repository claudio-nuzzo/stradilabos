#!/bin/sh
set -eu

if [ -f /etc/calamares/settings.conf ]; then
    python3 - <<'PY'
from pathlib import Path

import yaml

settings_path = Path("/etc/calamares/settings.conf")
settings = yaml.safe_load(settings_path.read_text(encoding="utf-8"))

settings["branding"] = "stradilabos"

module_paths = list(settings.get("modules-search", ["local"]))
custom_modules = "/usr/local/lib/calamares/modules"
if custom_modules not in module_paths:
    module_paths.append(custom_modules)
settings["modules-search"] = module_paths

instances = list(settings.get("instances") or [])
profile_instance = {
    "id": "profiles",
    "module": "packagechooser",
    "config": "stradilabos-profiles.conf",
}
if not any(
    item.get("id") == "profiles" and item.get("module") == "packagechooser"
    for item in instances
):
    instances.append(profile_instance)
device_instance = {
    "id": "device",
    "module": "packagechooser",
    "config": "stradilabos-device.conf",
}
if not any(
    item.get("id") == "device" and item.get("module") == "packagechooser"
    for item in instances
):
    instances.append(device_instance)
workspace_instance = {
    "id": "workspace",
    "module": "packagechooser",
    "config": "stradilabos-workspace.conf",
}
if not any(
    item.get("id") == "workspace" and item.get("module") == "packagechooser"
    for item in instances
):
    instances.append(workspace_instance)
settings["instances"] = instances

for phase in settings.get("sequence", []):
    if "show" in phase and "welcome" in phase["show"]:
        pages = phase["show"]
        profile_page = "packagechooser@profiles"
        device_page = "packagechooser@device"
        workspace_page = "packagechooser@workspace"
        if profile_page not in pages:
            pages.insert(pages.index("welcome") + 1, profile_page)
        if device_page not in pages:
            pages.insert(pages.index(profile_page) + 1, device_page)
        if workspace_page not in pages:
            pages.insert(pages.index(device_page) + 1, workspace_page)
    if "exec" in phase and "unpackfs" in phase["exec"]:
        jobs = phase["exec"]
        job = "stradilabprofiles"
        if job not in jobs:
            jobs.insert(jobs.index("unpackfs") + 1, job)

settings_path.write_text(
    yaml.safe_dump(settings, sort_keys=False, allow_unicode=True),
    encoding="utf-8",
)
PY
fi

if [ -f /usr/local/share/applications/calamares-install-debian.desktop ]; then
    cp /usr/local/share/applications/calamares-install-debian.desktop \
       /usr/share/applications/calamares-install-debian.desktop
fi

update-desktop-database /usr/local/share/applications || true
gtk-update-icon-cache -f /usr/local/share/icons/hicolor || true

# Identità coerente sia nella sessione Live sia nel sistema copiato da Calamares.
ln -sfn ../usr/lib/os-release /etc/os-release

# Il tema Plymouth viene incorporato nell'initramfs che live-build userà nella
# ISO e che Calamares copierà sul disco installato.
if command -v plymouth-set-default-theme >/dev/null 2>&1; then
    plymouth-set-default-theme stradilabos
    update-initramfs -u || true
fi

# La directory viene normalmente creata al primo avvio, ma prepararla nella
# ISO evita avvisi e rende affidabile LightDM anche nel filesystem Live.
if getent passwd lightdm >/dev/null 2>&1; then
    install -d -o lightdm -g lightdm -m 0750 /var/lib/lightdm/data
fi

# Il terminale rimane disponibile ai tecnici tramite Alt+F2, ma non compare
# nel menu destinato agli utenti ordinari.
mkdir -p /usr/local/share/applications
cat > /usr/local/share/applications/xfce4-terminal.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=Terminale
Exec=xfce4-terminal
NoDisplay=true
Terminal=false
EOF
