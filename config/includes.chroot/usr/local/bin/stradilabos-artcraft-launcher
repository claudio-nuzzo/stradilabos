#!/bin/sh
# Avvia o installa ArtCraft Launcher senza copiarlo nella ISO.
# Il download è esplicito (click dell'utente), limitato alle release ufficiali
# di storytold/craft-launcher e verificato con lo SHA-256 pubblicato upstream.
set -eu

VERSION="0.4.1"
BASE_URL="https://github.com/storytold/craft-launcher/releases/download/v${VERSION}"
case "$(uname -m)" in
  x86_64|amd64)
    ASSET="artcraft-launcher-${VERSION}-linux-x86_64.AppImage"
    SHA256="18ee584f651c6ab00f591f98118e78631638e0ea20f84b239b6c39b42a4f5426"
    ;;
  aarch64|arm64)
    ASSET="artcraft-launcher-${VERSION}-linux-aarch64.AppImage"
    SHA256="3b6c43202d7388a75435c63a3932a8aac6c24f5b15fb1b1865c81818847afd0f"
    ;;
  *)
    printf '%s\n' "ArtCraft Launcher non è disponibile per questa architettura." >&2
    exit 1
    ;;
esac

DATA_HOME=${XDG_DATA_HOME:-"$HOME/.local/share"}
INSTALL_DIR="$DATA_HOME/stradilabos/artcraft-launcher"
TARGET="$INSTALL_DIR/$ASSET"
DESKTOP_DIR="$DATA_HOME/applications"
DESKTOP_FILE="$DESKTOP_DIR/artcraft-launcher.desktop"

if [ ! -x "$TARGET" ]; then
  mkdir -p "$INSTALL_DIR"
  temporary="$TARGET.part"
  trap 'rm -f "$temporary"' EXIT HUP INT TERM
  url="$BASE_URL/$ASSET"
  if command -v curl >/dev/null 2>&1; then
    curl --fail --location --silent --show-error --connect-timeout 20 \
      --output "$temporary" "$url"
  elif command -v wget >/dev/null 2>&1; then
    wget --https-only --timeout=20 --output-document="$temporary" "$url"
  else
    printf '%s\n' "Manca un programma sicuro per il download (curl o wget)." >&2
    exit 1
  fi
  actual=$(sha256sum "$temporary" | awk '{print $1}')
  if [ "$actual" != "$SHA256" ]; then
    printf '%s\n' "Verifica SHA-256 fallita per ArtCraft Launcher." >&2
    exit 1
  fi
  chmod 0755 "$temporary"
  mv -f "$temporary" "$TARGET"
  trap - EXIT HUP INT TERM

  mkdir -p "$DESKTOP_DIR"
  cat > "$DESKTOP_FILE" <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=ArtCraft Launcher
GenericName=Strumenti creativi ArtCraft
Comment=Installa, aggiorna e avvia le applicazioni creative ArtCraft
Exec=$TARGET
TryExec=$TARGET
Icon=stradilabos-app-center
Terminal=false
Categories=Graphics;AudioVideo;Education;
StartupNotify=true
EOF
  command -v update-desktop-database >/dev/null 2>&1 && \
    update-desktop-database "$DESKTOP_DIR" >/dev/null 2>&1 || true
fi

exec "$TARGET" "$@"
