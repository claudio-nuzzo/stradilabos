#!/bin/sh
set -eu

url=${1:-}
app_id=${2:-stradilab}

case "$url" in
    https://*) ;;
    *)
        printf '%s\n' "StradiLabOS apre soltanto indirizzi HTTPS." >&2
        exit 2
        ;;
esac

# Il primo accesso mostra il browser completo. Le aperture successive usano
# Chrome e il suo profilo nativo, quindi account e cookie sono davvero gli
# stessi di Gmail, Classroom, Drive, Meet e delle altre web app.
if [ "$app_id" = "workspace-login" ] && command -v stradilabos-browser >/dev/null 2>&1; then
    exec stradilabos-browser "$url"
fi

config_dir=${XDG_CONFIG_HOME:-"$HOME/.config"}/stradilabos
profile_state=$config_dir/profiles.json
runtime_dir=${XDG_RUNTIME_DIR:-/tmp}
temporary_profile=false
if [ -e /run/live/medium ] \
    || grep -qw 'boot=live' /proc/cmdline 2>/dev/null \
    || grep -q '"device_mode"[[:space:]]*:[[:space:]]*"shared"' "$profile_state" 2>/dev/null; then
    temporary_profile=true
    user_data_dir="$runtime_dir/stradilabos-browser-session"
fi

chrome=""
if command -v google-chrome-stable >/dev/null 2>&1; then
    chrome=google-chrome-stable
elif command -v google-chrome >/dev/null 2>&1; then
    chrome=google-chrome
fi
if [ -n "$chrome" ]; then
    if [ "$temporary_profile" = true ]; then
        exec "$chrome" \
            --user-data-dir="$user_data_dir" \
            --profile-directory=Default \
            --app="$url" \
            --class="StradilabOS-$app_id" \
            --start-maximized
    fi
    exec "$chrome" \
        --app="$url" \
        --class="StradilabOS-$app_id" \
        --start-maximized
fi

if command -v chromium >/dev/null 2>&1; then
    # Ripiego Chromium: usa una directory coerente fra le micro-app. Chrome,
    # quando installato, viene sempre preferito dal ramo precedente.
    if [ -e /run/live/medium ] \
        || grep -qw 'boot=live' /proc/cmdline 2>/dev/null \
        || grep -q '"device_mode"[[:space:]]*:[[:space:]]*"shared"' "$profile_state" 2>/dev/null; then
        user_data_dir="$runtime_dir/stradilabos-browser-session"
    else
        user_data_dir="$config_dir/browser"
    fi

    exec chromium \
        --user-data-dir="$user_data_dir" \
        --app="$url" \
        --class="StradilabOS-$app_id" \
        --password-store=basic \
        --start-maximized \
        --no-first-run \
        --disable-session-crashed-bubble
fi

if command -v firefox-esr >/dev/null 2>&1; then
    exec firefox-esr --new-window "$url"
fi

exec xdg-open "$url"
