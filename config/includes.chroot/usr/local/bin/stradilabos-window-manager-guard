#!/bin/sh
# Guardia del gestore delle finestre di StradilabOS.
#
# Xfce avvia xfwm4 tramite xfce4-session, ma se xfwm4 non parte o termina
# (per esempio per un problema del compositore su GPU virtuali o datate)
# le finestre restano senza barra del titolo e senza i pulsanti Riduci,
# Massimizza e Chiudi. Questa guardia controlla che xfwm4 sia davvero in
# esecuzione e, se manca, lo riavvia con impostazioni via via più prudenti:
#
#   1. xfwm4 senza sincronizzazione verticale (--vblank=off);
#   2. xfwm4 senza compositore (--compositor=off);
#   3. tema Greybird di riserva e compositore spento.
#
# Ogni passaggio viene registrato nel journal (tag stradilabos-wm-guard) e
# in ~/.local/state/stradilabos/window-manager.log. I tentativi sono
# limitati per non creare cicli continui se xfwm4 continua a terminare.
set -u

[ -n "${DISPLAY:-}" ] || exit 0
command -v xfwm4 >/dev/null 2>&1 || exit 0

tag=stradilabos-wm-guard
state_dir=${XDG_STATE_HOME:-"$HOME/.local/state"}/stradilabos
mkdir -p "$state_dir" 2>/dev/null || true
report=$state_dir/window-manager.log
max_attempts=3
startup_grace=${STRADILABOS_WM_GRACE:-2}
check_interval=${STRADILABOS_WM_INTERVAL:-15}
confirmations=3

log() {
    printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >>"$report" 2>/dev/null || true
    if command -v logger >/dev/null 2>&1; then
        logger -t "$tag" -- "$1" 2>/dev/null || true
    fi
}

notify() {
    command -v notify-send >/dev/null 2>&1 || return 0
    notify-send --app-name=StradilabOS --icon=stradilabos "$1" "$2" >/dev/null 2>&1 || true
}

wm_running() {
    pgrep -u "$(id -u)" -x xfwm4 >/dev/null 2>&1 || return 1
    command -v xprop >/dev/null 2>&1 || return 0
    check=$(xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null | sed -n 's/.*window id # *//p')
    [ -n "$check" ] || return 1
    xprop -id "$check" _NET_WM_NAME 2>/dev/null | grep -qi xfwm4
}

wm_missing_confirmed() {
    count=0
    while [ "$count" -lt "$confirmations" ]; do
        wm_running && return 1
        count=$((count + 1))
        sleep 2
    done
    return 0
}

set_fallback_theme() {
    command -v xfconf-query >/dev/null 2>&1 || return 0
    xfconf-query -c xfwm4 -p /general/theme -s Greybird >/dev/null 2>&1 || \
        xfconf-query -c xfwm4 -p /general/theme -n -t string -s Greybird >/dev/null 2>&1 || true
}

disable_compositing() {
    command -v xfconf-query >/dev/null 2>&1 || return 0
    # Persiste la scelta nelle preferenze di xfwm4: il flag --compositor=off
    # vale solo per l'istanza lanciata, mentre scrivendo qui il valore resta
    # spento anche a un eventuale riavvio successivo senza flag.
    xfconf-query -c xfwm4 -p /general/use_compositing -s false >/dev/null 2>&1 || \
        xfconf-query -c xfwm4 -p /general/use_compositing -n -t bool -s false >/dev/null 2>&1 || true
}

start_wm() {
    attempt=$1
    case "$attempt" in
        1)
            log "xfwm4 assente: riavvio con sincronizzazione verticale disattivata"
            setsid xfwm4 --replace --vblank=off >/dev/null 2>&1 &
            ;;
        2)
            log "xfwm4 ancora assente: riavvio senza compositore"
            setsid xfwm4 --replace --compositor=off >/dev/null 2>&1 &
            ;;
        *)
            log "xfwm4 ancora assente: tema di riserva Greybird e compositore spento"
            set_fallback_theme
            setsid xfwm4 --replace --compositor=off >/dev/null 2>&1 &
            ;;
    esac
    sleep 5
    wm_running
}

sleep "$startup_grace"

# In Parallels ARM64 xfwm4 può risultare presente e annunciarsi correttamente
# tramite EWMH, ma restare in uno stato incompleto: le finestre sono gestite
# senza barra del titolo né pulsanti. Il solo controllo del processo produce
# quindi un falso positivo. Una sostituzione preventiva, identica alla prova
# manuale riuscita durante il collaudo del 28/8/2026, ricrea il window manager
# una volta sola con il compositore disattivato.
#
# La grazia iniziale è breve (2 secondi di default): l'autostart Xfce viene
# eseguito quando la sessione grafica è già disponibile, quindi la sostituzione
# può partire senza lunghe attese. Deve avvenire prima della schermata
# Benvenuto, che apre dopo circa 4 secondi, così l'utente non vede mai finestre
# prive di controlli. La preventiva è lineare, fuori dal ciclo: viene eseguita
# esattamente una volta per avvio di sessione; il ciclo successivo resta di solo
# monitoraggio e recupero graduato.
log "inizio inizializzazione preventiva di xfwm4 senza compositore"
disable_compositing
setsid xfwm4 --replace --compositor=off >/dev/null 2>&1 &
sleep 5
if wm_running; then
    log "inizializzazione preventiva di xfwm4 completata"
else
    log "inizializzazione preventiva non riuscita: attivo il recupero graduato"
fi

attempt=0
while :; do
    if wm_missing_confirmed; then
        recovered=0
        while [ "$attempt" -lt "$max_attempts" ]; do
            attempt=$((attempt + 1))
            if start_wm "$attempt"; then
                recovered=1
                log "xfwm4 di nuovo in esecuzione (tentativo $attempt)"
                if [ "$attempt" -ge 2 ]; then
                    notify "Finestre ripristinate" \
                        "I pulsanti delle finestre sono stati riattivati in modalità di compatibilità."
                fi
                break
            fi
        done
        if [ "$recovered" -eq 0 ]; then
            log "xfwm4 non riavviabile dopo $max_attempts tentativi: guardia terminata"
            notify "Problema con le finestre" \
                "Non è stato possibile ripristinare i pulsanti delle finestre. Riavvia il computer o contatta l'assistenza StradiLab."
            exit 1
        fi
    fi
    sleep "$check_interval"
done
