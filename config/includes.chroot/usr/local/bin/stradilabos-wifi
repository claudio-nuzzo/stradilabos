#!/usr/bin/python3
"""Selettore Wi-Fi semplice per il Benvenuto di StradiLabOS."""

from __future__ import annotations

import html
import shutil
import subprocess
from dataclasses import dataclass
from pathlib import Path

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk  # noqa: E402


@dataclass(frozen=True)
class Network:
    active: bool
    ssid: str
    signal: int
    security: str


def split_nmcli(line: str, fields: int = 4) -> list[str]:
    """Divide l'output terse di nmcli rispettandone gli escape con backslash."""
    values: list[str] = []
    current: list[str] = []
    escaped = False
    for character in line:
        if escaped:
            current.append(character)
            escaped = False
        elif character == "\\":
            escaped = True
        elif character == ":" and len(values) < fields - 1:
            values.append("".join(current))
            current = []
        else:
            current.append(character)
    if escaped:
        current.append("\\")
    values.append("".join(current))
    return values


def scan_networks() -> tuple[list[Network], str]:
    if not shutil.which("nmcli"):
        return [], "NetworkManager non è disponibile."
    try:
        subprocess.run(
            ["nmcli", "radio", "wifi", "on"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
            timeout=8,
        )
        result = subprocess.run(
            [
                "nmcli",
                "--colors",
                "no",
                "--terse",
                "--fields",
                "IN-USE,SSID,SIGNAL,SECURITY",
                "device",
                "wifi",
                "list",
                "--rescan",
                "yes",
            ],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
            timeout=20,
        )
    except (OSError, subprocess.SubprocessError) as error:
        return [], f"Scansione non riuscita: {error}"
    if result.returncode != 0:
        detail = result.stderr.strip() or "Controlla che il Wi-Fi sia acceso."
        return [], detail

    strongest: dict[str, Network] = {}
    for line in result.stdout.splitlines():
        values = split_nmcli(line)
        if len(values) != 4 or not values[1].strip():
            continue
        try:
            signal = max(0, min(100, int(values[2] or 0)))
        except ValueError:
            signal = 0
        network = Network(values[0].strip() == "*", values[1].strip(), signal, values[3].strip())
        previous = strongest.get(network.ssid)
        if previous is None or network.active or network.signal > previous.signal:
            strongest[network.ssid] = network
    return sorted(strongest.values(), key=lambda item: (not item.active, -item.signal, item.ssid.casefold())), ""


def signal_icon(signal: int) -> str:
    if signal >= 75:
        return "network-wireless-signal-excellent-symbolic"
    if signal >= 50:
        return "network-wireless-signal-good-symbolic"
    if signal >= 25:
        return "network-wireless-signal-ok-symbolic"
    return "network-wireless-signal-weak-symbolic"


def running_live() -> bool:
    if Path("/run/live/medium").exists():
        return True
    try:
        return "boot=live" in Path("/proc/cmdline").read_text(encoding="utf-8")
    except OSError:
        return False


class WifiWindow(Gtk.Window):
    def __init__(self) -> None:
        super().__init__(title="Collegati al Wi-Fi — StradiLabOS")
        self.set_default_size(600, 470)
        self.set_border_width(22)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_icon_name("network-wireless")

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.add(root)

        brand = Gtk.Label(xalign=0)
        brand.set_markup('<span foreground="#9b2335" weight="bold">STRADILAB · RETE</span>')
        root.pack_start(brand, False, False, 0)
        title = Gtk.Label(xalign=0)
        title.set_markup('<span size="xx-large" weight="bold">Scegli una rete Wi-Fi</span>')
        root.pack_start(title, False, False, 0)
        help_text = Gtk.Label(
            label="Seleziona la rete, premi Collega e inserisci la password quando richiesta.",
            xalign=0,
        )
        help_text.set_line_wrap(True)
        root.pack_start(help_text, False, False, 0)

        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_shadow_type(Gtk.ShadowType.IN)
        self.network_list = Gtk.ListBox()
        self.network_list.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.network_list.set_activate_on_single_click(False)
        self.network_list.connect("row-activated", self.connect_selected)
        scroll.add(self.network_list)
        root.pack_start(scroll, True, True, 0)

        self.status = Gtk.Label(xalign=0)
        self.status.set_line_wrap(True)
        root.pack_start(self.status, False, False, 0)

        buttons = Gtk.Box(spacing=8)
        advanced = Gtk.Button(label="Rete nascosta o avanzata…")
        advanced.connect("clicked", self.open_advanced)
        refresh = Gtk.Button(label="Aggiorna elenco")
        refresh.connect("clicked", self.refresh)
        self.connect_button = Gtk.Button(label="Collega")
        self.connect_button.get_style_context().add_class("suggested-action")
        self.connect_button.connect("clicked", self.connect_selected)
        buttons.pack_start(advanced, False, False, 0)
        buttons.pack_end(self.connect_button, False, False, 0)
        buttons.pack_end(refresh, False, False, 0)
        root.pack_start(buttons, False, False, 0)

        self.refresh()

    def message(self, title: str, detail: str, kind=Gtk.MessageType.INFO) -> None:
        dialog = Gtk.MessageDialog(
            transient_for=self,
            modal=True,
            message_type=kind,
            buttons=Gtk.ButtonsType.OK,
            text=title,
        )
        dialog.format_secondary_text(detail)
        dialog.run()
        dialog.destroy()

    def refresh(self, *_args) -> None:
        for row in self.network_list.get_children():
            self.network_list.remove(row)
        self.status.set_text("Ricerca delle reti in corso…")
        while Gtk.events_pending():
            Gtk.main_iteration()
        networks, error = scan_networks()
        if error:
            self.status.set_text(error)
        elif not networks:
            self.status.set_text("Nessuna rete visibile. Prova ad aggiornare o usa la configurazione avanzata.")
        else:
            self.status.set_text(f"{len(networks)} reti disponibili")
        for network in networks:
            row = Gtk.ListBoxRow()
            row.network = network
            content = Gtk.Box(spacing=12, margin=10)
            icon = Gtk.Image.new_from_icon_name(signal_icon(network.signal), Gtk.IconSize.LARGE_TOOLBAR)
            content.pack_start(icon, False, False, 0)
            labels = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            name = Gtk.Label(xalign=0)
            suffix = " · connessa" if network.active else ""
            name.set_markup(f"<b>{html.escape(network.ssid)}</b>{suffix}")
            security = network.security if network.security and network.security != "--" else "rete aperta"
            detail = Gtk.Label(label=f"Segnale {network.signal}% · {security}", xalign=0)
            labels.pack_start(name, False, False, 0)
            labels.pack_start(detail, False, False, 0)
            content.pack_start(labels, True, True, 0)
            row.add(content)
            self.network_list.add(row)
            if network.active:
                self.network_list.select_row(row)
        self.network_list.show_all()

    def ask_password(self, ssid: str) -> str | None:
        dialog = Gtk.Dialog(
            title=f"Password per {ssid}",
            transient_for=self,
            modal=True,
        )
        dialog.set_destroy_with_parent(True)
        dialog.add_buttons("Annulla", Gtk.ResponseType.CANCEL, "Collega", Gtk.ResponseType.OK)
        dialog.set_default_response(Gtk.ResponseType.OK)
        box = dialog.get_content_area()
        box.set_border_width(14)
        box.set_spacing(8)
        label = Gtk.Label(label="Inserisci la password Wi-Fi:", xalign=0)
        entry = Gtk.Entry()
        entry.set_visibility(False)
        entry.set_invisible_char("•")
        entry.set_activates_default(True)
        box.pack_start(label, False, False, 0)
        box.pack_start(entry, False, False, 0)
        dialog.show_all()
        response = dialog.run()
        password = entry.get_text() if response == Gtk.ResponseType.OK else None
        dialog.destroy()
        return password

    def connect_selected(self, *_args) -> None:
        row = self.network_list.get_selected_row()
        if row is None:
            self.message("Scegli una rete", "Seleziona prima una rete dall’elenco.")
            return
        network = row.network
        if network.active:
            self.message("Rete già connessa", f"Questo computer è già collegato a {network.ssid}.")
            return
        if "802.1X" in network.security or "EAP" in network.security:
            self.message(
                "Configurazione avanzata necessaria",
                "Questa rete usa credenziali aziendali o scolastiche. Si aprirà l’editor avanzato.",
            )
            self.open_advanced()
            return

        command = ["nmcli", "--wait", "45", "device", "wifi", "connect", network.ssid]
        if network.security and network.security != "--":
            password = self.ask_password(network.ssid)
            if password is None:
                return
            if not password:
                self.message("Password mancante", "Inserisci la password della rete.", Gtk.MessageType.WARNING)
                return
            command.extend(["password", password])

        self.connect_button.set_sensitive(False)
        self.status.set_text(f"Connessione a {network.ssid} in corso…")
        while Gtk.events_pending():
            Gtk.main_iteration()
        try:
            result = subprocess.run(
                command,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                check=False,
                timeout=50,
            )
        except (OSError, subprocess.SubprocessError) as error:
            self.message("Connessione non riuscita", str(error), Gtk.MessageType.ERROR)
        else:
            if result.returncode == 0:
                self.after_connection(network.ssid)
                return
            detail = result.stderr.strip() or result.stdout.strip() or "Controlla password e segnale."
            self.message("Connessione non riuscita", detail, Gtk.MessageType.ERROR)
        finally:
            self.connect_button.set_sensitive(True)
        self.refresh()

    def after_connection(self, ssid: str) -> None:
        if running_live():
            self.message(
                "Connessione riuscita",
                f"Il computer è collegato a {ssid}. Gli aggiornamenti saranno disponibili nel sistema installato.",
            )
            self.destroy()
            return

        updater = shutil.which("stradilabos-update")
        pkexec = shutil.which("pkexec")
        if not updater or not pkexec:
            self.message(
                "Connessione riuscita",
                f"Il computer è collegato a {ssid}. Il controllo automatico degli aggiornamenti partirà in seguito.",
            )
            self.destroy()
            return

        dialog = Gtk.MessageDialog(
            transient_for=self,
            modal=True,
            message_type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.YES_NO,
            text="Connessione riuscita",
        )
        dialog.format_secondary_text(
            f"Il computer è collegato a {ssid}. Vuoi scaricare e installare ora gli aggiornamenti StradiLabOS?"
        )
        response = dialog.run()
        dialog.destroy()
        if response == Gtk.ResponseType.YES:
            try:
                subprocess.Popen([pkexec, updater])
            except OSError as error:
                self.message("Impossibile avviare l’aggiornamento", str(error), Gtk.MessageType.ERROR)
        self.destroy()

    def open_advanced(self, *_args) -> None:
        if shutil.which("nm-connection-editor"):
            subprocess.Popen(["nm-connection-editor"])
        else:
            self.message("Editor non disponibile", "NetworkManager non ha installato l’editor avanzato.")


def main() -> int:
    window = WifiWindow()
    window.connect("destroy", Gtk.main_quit)
    window.show_all()
    Gtk.main()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
