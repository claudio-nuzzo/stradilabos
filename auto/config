#!/bin/sh
set -eu

architecture="${BUILD_ARCH:-amd64}"

case "$architecture" in
    amd64|arm64) ;;
    *)
        printf '%s\n' "Architettura non supportata: $architecture" >&2
        exit 1
        ;;
esac

lb config noauto \
    --mode debian \
    --distribution trixie \
    --architectures "$architecture" \
    --binary-images iso-hybrid \
    --archive-areas "main contrib non-free non-free-firmware" \
    --apt-recommends true \
    --updates true \
    --firmware-binary true \
    --firmware-chroot true \
    --debian-installer none \
    --bootappend-live "boot=live components username=stradi hostname=stradilabos locales=it_IT.UTF-8 keyboard-layouts=it timezone=Europe/Rome utc=yes quiet splash loglevel=3" \
    --iso-application "StradiLabOS Live" \
    --iso-publisher "StradiLab - IIS Antonio Stradivari Cremona" \
    --iso-volume "STRADILABOS" \
    --image-name "stradilabos-live" \
    "$@"
